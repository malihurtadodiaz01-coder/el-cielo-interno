---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import WaButton from "../components/WaButton.astro";
import Trayectoria from "../components/Trayectoria.astro";
import carlos from "../assets/carlos.jpg";
---
<BaseLayout title="Sobre Carlos · El Cielo Interno" description="Trayectoria, formación y enfoque de Carlos Eduardo Hurtado Díaz, psicólogo y terapeuta transpersonal.">
  <Hero title="Trayectoria y Propósito" compact />
  <section>
    <div class="wrap split">
      <Image src={carlos} alt="Retrato de Carlos Hurtado" width={560} />
      <div>
        <Trayectoria />
        <WaButton msg="Hola Carlos, te escribo desde el sitio El Cielo Interno." />
      </div>
    </div>
  </section>
</BaseLayout>
