---
import { testimonios, site } from "../data/site";
---
<section id="testimonios">
  <div class="wrap">
    <h2 class="center">Testimonios del Taller El Cielo Interno</h2>
    <div class="testi">
      {testimonios.map((t) => (
        <figure class="card">
          <blockquote>{t.texto}</blockquote>
          <figcaption>{t.nombre}</figcaption>
        </figure>
      ))}
    </div>
    <p class="center muted" style="margin-top:1.5rem">
      Publicados en <a href={site.social.instagram} rel="noopener">@el.cielo.interno</a>
    </p>
  </div>
</section>
<style>
  .testi { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); align-items: start; }
  figure { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  blockquote { margin: 0; font-family: var(--font-title); font-size: 1.25rem; line-height: 1.45; color: var(--noche); }
  blockquote::before { content: "“"; display: block; font-size: 3rem; line-height: .6; color: var(--sol); }
  figcaption { font-weight: 700; color: var(--cielo-profundo); }
</style>
