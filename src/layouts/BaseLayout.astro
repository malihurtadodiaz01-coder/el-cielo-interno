---
import "../styles/global.css";
import { site, nav, wa, u } from "../data/site";
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const ld = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.author,
  url: Astro.site?.toString(),
  jobTitle: "Psicólogo y terapeuta transpersonal",
  sameAs: Object.values(site.social),
};
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta name="theme-color" content="#1f4e9c" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a href="#main" class="skip">Saltar al contenido</a>
    <header class="top">
      <div class="wrap bar">
        <a href={u("/")} class="brand">El Cielo Interno</a>
        <button class="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu">☰</button>
        <nav id="menu" aria-label="Principal">
          {nav.map((n) => (
            <a href={u(n.href)} aria-current={path === (u(n.href).replace(/\/$/, "") || "/") ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="wrap fgrid">
        <div>
          <p class="brand">El Cielo Interno</p>
          <p>{site.tagline}</p>
        </div>
        <div>
          <p><strong>Sigue el camino</strong></p>
          <ul>
            <li><a href={site.social.instagram} rel="noopener">Instagram</a></li>
            <li><a href={site.social.youtube} rel="noopener">YouTube</a></li>
            <li><a href={site.social.facebook} rel="noopener">Facebook</a></li>
            <li><a href={site.social.threads} rel="noopener">Threads</a></li>
            <li><a href={site.social.linktree} rel="noopener">Linktree</a></li>
          </ul>
        </div>
        <div>
          <p><strong>Información</strong></p>
          <ul>
            <li><a href={u("/privacidad")}>Privacidad</a></li>
            <li><a href={u("/aviso-legal")}>Aviso legal</a></li>
            <li><a href={u("/contacto")}>Contacto</a></li>
          </ul>
        </div>
      </div>
      <p class="copy">© {new Date().getFullYear()} {site.author}</p>
    </footer>
    <a class="wa-float" href={wa("Hola Carlos, te escribo desde el sitio El Cielo Interno.")} rel="noopener" aria-label="Escríbeme por WhatsApp">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 9c0 4 3 7 7 7l1-2-2-1-1 1c-1-.5-2-1.500-2.500-2.500l1-1-1-2z" fill="currentColor"/></svg>
      <span>WhatsApp</span>
    </a>
    <script>
      const b = document.querySelector<HTMLButtonElement>(".burger");
      const m = document.getElementById("menu");
      b?.addEventListener("click", () => {
        const open = m?.classList.toggle("open");
        b.setAttribute("aria-expanded", String(!!open));
      });
    </script>
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: #fff; padding: .5rem 1rem; z-index: 99; }
  .top { position: sticky; top: 0; z-index: 20; background: rgba(247,249,252,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--cielo-claro); }
  .bar { display: flex; align-items: center; justify-content: space-between; padding: .7rem 0; gap: 1rem; }
  .brand { font-family: var(--font-title); font-size: 1.6rem; color: var(--cielo-profundo); text-decoration: none; font-weight: 500; }
  #menu { display: flex; gap: 1.1rem; flex-wrap: wrap; font-size: .95rem; }
  #menu a { text-decoration: none; color: var(--noche); padding: .2rem 0; border-bottom: 2px solid transparent; }
  #menu a:hover, #menu a[aria-current="page"] { border-color: var(--sol); }
  .burger { display: none; background: none; border: 0; font-size: 1.6rem; color: var(--cielo-profundo); cursor: pointer; }
  @media (max-width: 1000px) {
    .burger { display: block; }
    #menu { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; background: var(--nube); padding: 1rem 1.5rem; border-bottom: 1px solid var(--cielo-claro); }
    #menu.open { display: flex; }
  }
  footer { background: var(--noche); color: #dfe6f1; padding: 3rem 0 6rem; }
  footer a { color: #cfe3f5; }
  footer .brand { color: #fff; }
  .fgrid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  footer ul { list-style: none; padding: 0; margin: 0; }
  .copy { text-align: center; margin-top: 2rem; font-size: .85rem; opacity: .7; }
  .wa-float { position: fixed; right: 1rem; bottom: 1rem; z-index: 30; display: flex; gap: .5rem; align-items: center; background: #25d366; color: #0b3d1e; font-weight: 700; padding: .75rem 1.1rem; border-radius: 999px; text-decoration: none; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
  .wa-float:hover { color: #0b3d1e; background: #3be07c; }
</style>
